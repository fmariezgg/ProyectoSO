    D3 --> E
    D4 --> E
    D5 --> E

    classDef primary fill:#00abb9,stroke:#008c99,stroke-width:2px,color:#000000
    classDef secondary fill:#00c4d4,stroke:#008c99,stroke-width:2px,color:#000000
