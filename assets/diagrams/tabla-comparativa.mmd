    B --> C3["<div style='padding:8px'><b>Compatibilidad Binaria</b><br/><span style='color:#00abb9;font-weight:bold'>DO: Nativa x86-64</span><br/><span style='color:#666666'>VMware: Emulacion ARM</span></div>"]
    B --> C4["<div style='padding:8px'><b>Requisitos Cliente</b><br/><span style='color:#00abb9;font-weight:bold'>DO: Minimos</span><br/><span style='color:#666666'>VMware: Hardware potente</span></div>"]
    B --> C5["<div style='padding:8px'><b>Flexibilidad</b><br/><span style='color:#00abb9;font-weight:bold'>DO: QCOW2 + cloud-init</span><br/><span style='color:#666666'>VMware: Conversion compleja</span></div>"]

    C1 --> D1["<div style='padding:8px'><b>IMPACTO: EFICIENCIA</b><br/>Inmediatez en practicas</div>"]
    C2 --> D2["<div style='padding:8px'><b>IMPACTO: SOSTENIBILIDAD</b><br/>Costo predecible</div>"]
    C3 --> D3["<div style='padding:8px'><b>IMPACTO: EQUIDAD</b><br/>Entorno homogeneo x86</div>"]
    C4 --> D4["<div style='padding:8px'><b>IMPACTO: ACCESIBILIDAD</b><br/>Cualquier dispositivo</div>"]
    C5 --> D5["<div style='padding:8px'><b>IMPACTO: ESTANDARIZACION</b><br/>Trabajo asincrono</div>"]

    D1 --> E["<div style='font-size:20px;padding:12px;text-align:center'><b>CONCLUSION</b><br/>DigitalOcean ofrece mejor relacion<br/>valor/tiempo para contexto academico</div>"]
